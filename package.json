{
  "name": "sea-siege",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "ui:add": "shadcn add",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:client": "vitest run tests/*.test.ts",
    "p0:preflight": "node scripts/p0-preflight.mjs",
    "db:build": "spacetime build --module-path ./spacetimedb",
    "db:generate": "spacetime generate --lang typescript --module-path ./spacetimedb --out-dir ./src/module_bindings",
    "db:typecheck": "npm --prefix spacetimedb run typecheck",
    "db:test": "npm --prefix spacetimedb test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "phaser": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "spacetimedb": "^2.12.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
