# SpacetimeDB Host
# - Local desktop or in-container tests: http://127.0.0.1:3000
# - GitHub Codespaces browser preview: Vite proxies /v1 over port 5173; client uses same-origin
# - Production deployments: set to the explicit SpacetimeDB Cloud or standalone host
VITE_SPACETIME_HOST=http://127.0.0.1:3000
VITE_SPACETIME_DATABASE=sea-siege-dev
